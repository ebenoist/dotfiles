[alias]
  co = checkout
  st = status
  ci = commit
  pu = pull --rebase
  ps = push
  br = branch
  l = log --graph --pretty=format:'%an: %s - %Cred%h%Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  slog = log --pretty=format:'%C(yellow)%h %Cred%ad %Cblue%an%Cgreen%d %Creset%s' --date=short
  slognc = log --pretty=format:'%h %ad %an%d %s' --date=short
	files = "!git show --name-only --format= \"$@\" #"
	review = "!f() { sha=${1:-HEAD}; notes=$(mktemp -t review-${sha}-XXXX.md); echo \"# Review: $sha\" > \"$notes\"; echo \"\" >> \"$notes\"; git show \"$sha\" >> \"$notes\"; echo \"Notes: $notes\"; vim -c \"argdo tabnew | Gvdiffsplit ${sha}~1 | botright vsplit ${notes}\" -c \"tabfirst | tabclose\" $(git show --name-only --format= ${sha}); }; f"
[color]
  diff = auto
  status = auto
  branch = auto
[core]
  autocrlf = input
	excludesfile = ~/.gitignore
[apply]
  whitespace = nowarn
[web]
  browser = open
[merge]
	conflictstyle = diff3
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true
[user]
	name = Erik
