# enable colored output from ls, etc
export CLICOLOR=1
export LSCOLORS="Exfxcxdxbxegedabagacad"
export GPG_TTY=$(tty)
export COLORTERM=truecolor

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# nim
export PATH="$HOME/.nimble/bin:$PATH"

# opencode
export PATH=/home/erik/.opencode/bin:$PATH
export PATH=/home/erik/.cargo/bin:$PATH

# load
export PATH="$HOME/bin:$HOME/.local/bin:node_modules/.bin:$PATH"
export CDPATH=".:$HOME/dev"
export VISUAL="nvim"
export GIT_EDITOR="nvim"
export EDITOR="$VISUAL"

# macOS-specific chrome alias
if [[ "$OSTYPE" == "darwin"* ]]; then
  alias chrome="/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome"
fi

# GNU tools (macOS homebrew)
if [[ "$OSTYPE" == "darwin"* ]]; then
  export PATH="/usr/local/opt/gnu-sed/libexec/gnubin:$PATH"
fi

# GO
export GOPATH="$HOME/dev/go"
export PATH="$GOPATH/bin:$PATH"

# macOS homebrew paths
if [[ "$OSTYPE" == "darwin"* ]]; then
  # Postgres
  export PATH="/usr/local/opt/postgresql@11/bin:$PATH"
  # Protobuf 3.6
  export PATH="/usr/local/opt/protobuf@3.6/bin:$PATH"
fi

# prompt
export PS1="\[$Green\]\$(vcprompt -f '[%b%u%m]')\[$Color_Off\][\w]❥ "

# Ghostty terminal support
if [ -n "$GHOSTTY_RESOURCES_DIR" ]; then
  export TERMINFO="$GHOSTTY_RESOURCES_DIR/terminfo"
fi

if [[ -n $SSH_CLIENT ]]; then
  export PS1="\[$Green\]\$(vcprompt -f '[%b%u%m]')\[$Color_Off\][\w]@\h ❥ "
fi

export PS0='\033]0;\w\007'

# Linux-specific fly.io path
if [[ "$(uname)" == "Linux" ]]; then
  export FLYCTL_INSTALL="/home/erik/.fly"
  export PATH="$FLYCTL_INSTALL/bin:$PATH"

  # Font rendering for GTK/Qt on Wayland
  export FREETYPE_PROPERTIES="truetype:interpreter-version=40"

  # Note: ELECTRON_OZONE_PLATFORM_HINT was removed in Electron 38+
  # Wayland flags are now passed via command line in sway config

  # Sway IPC socket (auto-detect if not already set)
  if [ -z "$SWAYSOCK" ]; then
    export SWAYSOCK=$(ls /run/user/$(id -u)/sway-ipc.*.sock 2>/dev/null | head -1)
  fi
fi

# Include custom aliases
[[ -f ~/.exports.local ]] && source ~/.exports.local

export DOCKER_COMPOSE_FLAGS=''
unset LDFLAGS

# Android SDK paths (mainly for Linux)
if [[ "$(uname)" == "Linux" ]]; then
  export ANDROID_HOME=${HOME}/Android/Sdk
  export PATH=${ANDROID_HOME}/tools:${PATH}
  export PATH=${ANDROID_HOME}/emulator:${PATH}
  export PATH=${ANDROID_HOME}/platform-tools:${PATH}
fi

export PATH="$HOME/.tfenv/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
