# xkcd-style passphrase: three words hyphenated + two-digit number, copied and printed
xkcdpw() {
  local pw="$(xkcdpass -n 3 -d -)-$(printf '%02d' $((RANDOM % 100)))"
  if command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$pw" | wl-copy
  elif command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$pw" | pbcopy
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$pw" | xclip -i -selection clipboard
  fi
  printf '%s\n' "$pw"
}

# cmus + fzf integration
cmus-fzf() {
  track=$(cat ~/.config/cmus/lib.pl 2>/dev/null | fzf)
  [ -n "$track" ] && cmus-remote -f "$track"
}

cmus-queue() {
  track=$(find /multimedia -type f \( -name "*.mp3" -o -name "*.flac" -o -name "*.ogg" -o -name "*.m4a" \) 2>/dev/null | fzf)
  [ -n "$track" ] && cmus-remote -q "$track"
}
