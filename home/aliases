clocks() {
  echo "PST:    $(TZ='America/Los_Angeles' date '+%H:%M %Z')"
  echo "CST:    $(TZ='America/Chicago' date '+%H:%M %Z')"
  echo "EST:    $(TZ='America/New_York' date '+%H:%M %Z')"
  echo "London: $(TZ='Europe/London' date '+%H:%M %Z')"
  echo "UTC:    $(TZ='UTC' date '+%H:%M %Z')"
  echo "ARG:    $(TZ='America/Argentina/Buenos_Aires' date '+%H:%M %Z')"
}

git-files() {
  git ls-tree --full-tree -r --name-only HEAD
}

re-ctags() {
  if [ -f .tags ] ; then
    rm .tags
  fi
  git-files | xargs ctags -a -f .tags -L
}

