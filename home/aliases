alias ln='ln -v'
alias mkdir='mkdir -p'
alias vi='nvim'
alias vim='nvim'
#alias docker=prodman

# Platform-specific aliases
if [[ "$(uname)" == "Linux" ]]; then
  # Clipboard: Wayland vs X11
  if [[ -n "$WAYLAND_DISPLAY" ]]; then
    alias pbcopy="wl-copy"
    alias pbpaste="wl-paste"
  else
    alias pbcopy="xclip -i -selection clipboard"
    alias pbpaste="xclip -o -selection clipboard"
  fi
  alias distro='neofetch'
  alias fetch='neofetch'
  command -v batcat >/dev/null 2>&1 && alias bat="batcat"
  alias android-studio="$HOME/android-studio/bin/studio.sh"
fi

if [[ "$(uname)" == "Darwin" ]]; then
  # On macOS, may need GNU tools with g prefix
  command -v gtar >/dev/null 2>&1 && alias tar='gtar'
  command -v gsed >/dev/null 2>&1 && alias sed='gsed'
fi

alias awsume=". awsume"
alias l='eza'
alias ssh='TERM=xterm-256color ssh'

git-files() {
  git ls-tree --full-tree -r --name-only HEAD
}

re-ctags() {
  if [ -f .tags ] ; then
    rm .tags
  fi
  git-files | xargs ctags -a -f .tags -L
}

# Linux-specific desktop environment functions
if [[ "$(uname)" == "Linux" ]]; then
  light() {
    gsettings set org.gnome.desktop.interface gtk-theme Yaru-light && gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
  }

  dark() {
    gsettings set org.gnome.desktop.interface gtk-theme Yaru-dark && gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
  }
fi

git-clean() {
  git branch --merged | egrep -v "(^\*|master|dev|main)" | xargs git branch -d
}

# Zellij aliases
alias za="$HOME/.bin/za"

