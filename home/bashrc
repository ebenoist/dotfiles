set +x
# Ghostty shell integration
if [ -n "${GHOSTTY_RESOURCES_DIR}" ]; then
  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/bash/ghostty.bash"
fi

# macOS Homebrew path (Apple Silicon)
if [ -f '/opt/homebrew/bin/brew' ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

eval "$(~/.local/bin/mise activate bash)"

source ~/.colors;
source ~/.aliases;
source ~/.exports;

## language ENV
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

## direnv
eval "$(direnv hook bash)"

## gpg
export GPG_TTY=$(tty)

## completions
# Linux
[[ -r "/usr/share/bash-completion/completions/git" ]] && . "/usr/share/bash-completion/completions/git"
# regenerate after an omp upgrade: omp completions bash > ~/.local/share/bash-completion/completions/omp.bash
[[ -r "$HOME/.local/share/bash-completion/completions/omp.bash" ]] && . "$HOME/.local/share/bash-completion/completions/omp.bash"


### MACOS
# macOS homebrew
[[ -r "/usr/local/etc/profile.d/bash_completion.sh" ]] && . "/usr/local/etc/profile.d/bash_completion.sh"

if [ -x "$(command -v brew)" ]; then
  if [ -f $(brew --prefix)/etc/bash_completion ]; then
  . $(brew --prefix)/etc/bash_completion
  fi

  if [ -f `brew --prefix`/etc/bash_completion.d/git-completion.bash ]; then
  . `brew --prefix`/etc/bash_completion.d/git-completion.bash
  fi

  if [ -f `brew --prefix`/etc/bash_completion.d/git-prompt.sh ]; then
  . `brew --prefix`/etc/bash_completion.d/git-prompt.sh
  fi
fi

## db history stores all of my bash history in a sqlite database
export HISTSIZE=$HOME/.bash_history
export HISTFILESIZE=1000
export HISTSIZE=1000
export HISTTIMEFORMAT="%s "
export HISTCONTROL=ignorespace:erasedups
export DBHISTORY=true
export DBHISTORYFILE=$HOME/.dbhist.sql
source ~/.dbhist.sh;

## local install paths
PATH="$HOME/bin:$PATH"
PATH="$HOME/.local/bin:$PATH"
PATH="$HOME/bin:$PATH"

export CLAUDE_CODE_ENABLE_TELEMETRY=0

complete -C /usr/bin/terraform terraform

if [[ "$(uname)" == "Linux" ]]; then
  if [ -f '/home/erik/google-cloud-sdk/path.bash.inc' ]; then . '/home/erik/google-cloud-sdk/path.bash.inc'; fi
  if [ -f '/home/erik/google-cloud-sdk/completion.bash.inc' ]; then . '/home/erik/google-cloud-sdk/completion.bash.inc'; fi
fi

if [ -f '~/.bash_completion/zellij' ]; then . '~/.bash_completion/zellij'; fi

# pnpm
export PNPM_HOME="/home/erik/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

export GPG_TTY=$(tty)
. "/home/erik/.deno/env"

#source /home/erik/.local/share/bash-completion/completions/deno.bash

. "$HOME/.local/share/../bin/env"

# swiftly (Swift toolchain manager) — interactive (non-login) shells too
[ -f "$HOME/.local/share/swiftly/env.sh" ] && . "$HOME/.local/share/swiftly/env.sh"
