#!/bin/bash

echo "=== Display Configuration Test ==="
echo

echo "Available displays:"
xrandr --listproviders
echo

echo "Connected monitors:"
xrandr | grep " connected"
echo

echo "Current xrandr status:"
xrandr --query | head -20
echo

echo "BSPWM monitors:"
if command -v bspc &> /dev/null; then
    bspc query -M --names
    echo
    echo "BSPWM desktops:"
    bspc query -D --names
else
    echo "BSPWM not running"
fi
echo

echo "=== Expected Configuration ==="
echo "DP-1: Left monitor, portrait mode (1080x1920), position 0x0"
echo "HDMI-A-1: Main monitor, landscape mode (1920x1080), position 1080x0, PRIMARY"
echo "Desktop assignment:"
echo "  HDMI-A-1 (main): desktops 1-5"
echo "  DP-1 (left): desktops 6-0"