#!/bin/bash

# Set up environment
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce

# Configure displays
# DP monitor (left, portrait) and main monitor (center)
if xrandr | grep -q "DP-1 connected"; then
    if xrandr | grep -q "HDMI-A-1 connected"; then
        # Dual monitor setup: DP-1 (left, portrait) + HDMI-A-1 (main, center)
        xrandr --output DP-1 --mode 1920x1080 --rotate left --pos 0x0 \
               --output HDMI-A-1 --mode 1920x1080 --primary --pos 1080x0
    else
        # Single DP monitor in portrait
        xrandr --output DP-1 --mode 1920x1080 --rotate left --primary
    fi
elif xrandr | grep -q "HDMI-A-1 connected"; then
    # Single main monitor
    xrandr --output HDMI-A-1 --mode 1920x1080 --primary
fi

# Start XFCE session manager in background for logout functionality
xfce4-session &

# Start the session
exec bspwm