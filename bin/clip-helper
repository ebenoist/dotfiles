#!/usr/bin/env bash
# clip-helper: A smart clipboard handler that works across local and remote sessions
# 
# This script detects if we're in a remote session and intelligently handles
# clipboard operations to ensure content is available on the local machine.

# Detect platform
platform=$(uname)

# Detect if we're in an SSH/Mosh session
is_remote=false
if [[ -n "$SSH_CLIENT" || -n "$SSH_TTY" || -n "$MOSH_SERVER_PID" ]]; then
  is_remote=true
fi

# Get input from stdin
input=$(cat)

# Handle local sessions
if [[ "$is_remote" == "false" ]]; then
  if [[ "$platform" == "Darwin" ]]; then
    # On macOS, use pbcopy
    echo -n "$input" | pbcopy
  elif [[ -n "$WAYLAND_DISPLAY" ]]; then
    # On Wayland, use wl-copy
    echo -n "$input" | wl-copy
  else
    # On X11, use xclip
    echo -n "$input" | xclip -selection clipboard
  fi
  exit 0
fi

# For remote sessions, use OSC 52 to copy to the client's clipboard
# Encode input as base64
encoded=$(echo -n "$input" | base64 | tr -d '\n')
# Maximum allowed length for OSC 52 is 100,000 bytes, this is a conservative limit
max_len=74994
if [[ ${#encoded} -gt $max_len ]]; then
  encoded=${encoded:0:$max_len}
  echo "Warning: Input was too long and has been truncated" >&2
fi

# Send the OSC 52 escape sequence directly to the terminal
# Write to /dev/tty to bypass multiplexers like zellij/tmux
printf "\033]52;c;%s\a" "$encoded" > /dev/tty

# Also copy to local clipboard as fallback
if [[ "$platform" == "Linux" ]]; then
  if [[ -n "$WAYLAND_DISPLAY" ]]; then
    echo -n "$input" | wl-copy
  else
    echo -n "$input" | xclip -selection clipboard
  fi
fi

exit 0