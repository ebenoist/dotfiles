#!/usr/bin/env bash

URL=$1
BASE=$(basename $URL)

echo "fetching ${URL}"
echo "saving ${BASE}"

google-chrome \
  --headless \
  --window-size=1920,1080 \
  --run-all-compositor-stages-before-draw \
  --virtual-time-budget=9000 \
  --disable-gpu \
  --dump-dom $URL | monolith -i -v - > $BASE.html

DUMP=$(cat $BASE.html)

curl -X 'POST' \
    'https://mealie.benoist.dev/api/recipes/create/html-or-json' \
    -H 'accept: application/json' \
    -H 'Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxOTFmMWFhYy02MGQ3LTQ4ZGUtYWZlNy04OTcwOTQxNjFhMjkiLCJleHAiOjE3MzE3ODQxNzEsImlzcyI6Im1lYWxpZSJ9.4qrjfvvRNxr5VUm5lm_CvXBBfXp9YmPGa_Mn14rrWfA' \
    -H 'Content-Type: application/json' \
    -d "{ \"data\": \"${DUMP}\" }"
