#!/usr/bin/env bash

TTL=$((20*60))
NOW=$(date +%s)
LAST_UPDATED=$(date +%s -r $HOME/.op-cache)
ELAPSED=$(($NOW - $LAST_UPDATED))

if [[ ! -f "$HOME/.op-cache" ]]; then
  echo "no-cache"
  op signin -f > ~/.op-cache
elif [[ $ELAPSED -gt $TTL ]]; then
  echo "cache expired"
  op signin -f > ~/.op-cache
else
  echo "logged in, will expire in $(($TTL - $ELAPSED)) seconds"
fi

eval $(cat ~/.op-cache)

SELECT_ITEM=$(op item list --format=json |\
  jq -c -r '.[] | {
    title,
    id,
    created_at
  }' | fzf --ansi --preview="echo {} | jq -r ." | op item get --format=json -)

echo $SELECT_ITEM | jq -c -r '.fields | .[] | { label: .label, value: .value }' |\
  fzf --ansi --preview="echo {} | jq -C ." | jq -r .value | xclip -i -selection clipboard
