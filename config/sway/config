# Sway config

### Environment
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec systemctl --user start wayvnc.service
exec systemctl --user start sunshine.service
exec /home/erik/bin/lan-mouse --capture-backend layer-shell --emulation-backend wlroots daemon

### Variables
set $mod Mod4
set $term ghostty
set $menu fuzzel

# Dracula colors
set $bg #282a36
set $fg #f8f8f2
set $border #bd93f9
set $border_inactive #44475a
set $urgent #ff5555

### Output
# Identify by EDID (make/model/serial) so MST connector shuffling
# (DP-4 vs DP-5 swapping between boots) doesn't black out the display.
set $left   "Dell Inc. DELL U2718Q 4K8X793J1JNL"
set $center "Dell Inc. DELL U2725QE 3CLD984"

# Left monitor (vertical/portrait) - chat apps
output $left transform 270 scale 2 pos 0 0
# Center landscape (main work display) - the U2725QE
output $center scale 2 pos 1080 840

# Font scaling: gsettings text-scaling-factor 1.0

output * bg $bg solid_color

# Workspaces -> outputs
workspace 1 output $center
workspace 2 output $center
workspace 3 output $center
workspace 4 output $center
workspace 5 output $center
workspace 6 output $center
workspace 7 output $center
workspace 8 output $left
workspace 9 output $left
workspace 10 output $center

# Dedicated filler so sway never borrows one of the numbered workspaces
# above to keep the always-on headless output non-empty (see vnc-watch).
workspace 11 output HEADLESS-1
# Same for the JetKVM capture dongle on HDMI-A-1; without this it steals
# the lowest free numbered workspace (2, then 4) at boot.
workspace 12 output HDMI-A-1

### Input
input type:keyboard {
    xkb_layout us
    xkb_variant altgr-intl
    xkb_options ctrl:nocaps
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

input type:pointer {
    natural_scroll enabled
}

### Appearance
gaps inner 10
gaps outer 5
default_border pixel 2
smart_borders on
smart_gaps on

client.focused          $border          $bg $fg $border         $border
client.focused_inactive $border_inactive $bg $fg $border_inactive $border_inactive
client.unfocused        $border_inactive $bg $fg $border_inactive $border_inactive
client.urgent           $urgent          $bg $fg $urgent         $urgent

### Core bindings
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+space exec $menu
bindsym $mod+d exec $menu
# Chord cheatsheet / command palette (parses live config; type to filter, Enter runs it)
bindsym $mod+slash exec /home/erik/bin/sway-palette
# Mouse fallback for remote sessions where macOS/Moonlight eats keystrokes:
# Cmd + right-click anywhere pops the launcher.
bindsym --whole-window $mod+button3 exec $menu
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
### Idle & Lock
exec swayidle -w \
    timeout 300 '/usr/bin/swaylock -f' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '/usr/bin/swaylock -f'

bindsym $mod+Escape exec /usr/bin/swaylock -f
bindsym $mod+Shift+c exec caffeine

### Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

### Move windows
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces (sov shows overview while switching)
bindsym --no-repeat $mod+1 workspace number 1; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+2 workspace number 2; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+3 workspace number 3; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+4 workspace number 4; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+5 workspace number 5; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+6 workspace number 6; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+7 workspace number 7; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+8 workspace number 8; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+9 workspace number 9; exec "echo 1 > /tmp/sovpipe"
bindsym --no-repeat $mod+0 workspace number 10; exec "echo 1 > /tmp/sovpipe"

bindsym --release $mod+1 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+2 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+3 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+4 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+5 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+6 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+7 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+8 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+9 exec "echo 0 > /tmp/sovpipe"
bindsym --release $mod+0 exec "echo 0 > /tmp/sovpipe"

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Sway overview toggle
bindsym $mod+Tab exec "echo 2 > /tmp/sovpipe"

### Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

### Scratchpad
bindsym $mod+minus move scratchpad
bindsym $mod+Shift+minus scratchpad show

### Dropdown terminal (quake-style)
# 65ppt: btop needs 24+ rows; 40ppt only gave ~17 on the 1080-logical center
# ghostty class must be a dotted GTK app-id, plain "dropdown" is rejected
for_window [app_id="quake.dropdown"] floating enable, sticky enable, resize set 100ppt 65ppt, move position 0 0, move scratchpad, scratchpad show
bindsym $mod+grave exec swaymsg '[app_id="quake.dropdown"] scratchpad show' || ghostty --class=quake.dropdown --background-opacity=0.85

### Resize mode
mode "resize" {
    bindsym Left resize shrink width 30px
    bindsym Down resize grow height 30px
    bindsym Up resize shrink height 30px
    bindsym Right resize grow width 30px
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
bindsym $mod+r mode "resize"

### Special characters
bindsym Alt+Shift+minus exec sh -c 'wl-copy "—" && wtype -M ctrl v -m ctrl'

### Media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+

### Screenshots (annotate with swappy, Ctrl+c to copy, Ctrl+s to save)
bindsym $mod+s exec 'grim -s 1 - | swappy -f -'
bindsym $mod+Shift+s exec 'grim -s 1 -g "$(slurp)" - | swappy -f -'

### Window rules
for_window [app_id="pavucontrol"] floating enable

# Chat apps -> left monitor (workspace 8)
# assign rules ensure windows land on ws8, append_layout handles tiling
assign [app_id="signal"] workspace 8
assign [app_id="Slack"] workspace 8
assign [app_id="chrome-app.fastmail.com__-Default"] workspace 8
assign [app_id="chrome-bsky.app__-Default"] workspace 8

### Bar
bar {
    position top
    status_command ~/.config/sway/status
    tray_output *
    colors {
        background $bg
        statusline $fg
        separator $border_inactive
        focused_workspace $border $border $fg
        active_workspace $border_inactive $border_inactive $fg
        inactive_workspace $bg $bg #6272a4
        urgent_workspace $urgent $urgent $fg
    }
}

### Sway Overview (sov)
exec rm -f /tmp/sovpipe && mkfifo /tmp/sovpipe && tail -f /tmp/sovpipe | sov -t 500 -k 65515

### Exposé window picker (exposway); sov above covers workspace schemas
set $exposway_dir /home/erik/.local/state/exposway
exec mkdir -p $exposway_dir && EXPOSWAYDIR=$exposway_dir/ /home/erik/.local/bin/exposwayd
bindsym $mod+x exec EXPOSWAYDIR=$exposway_dir/ EXPOSWAYMON=$exposway_dir/output /home/erik/.local/bin/exposway

### Night light (auto color temperature)
exec wlsunset -l 41.0 -L -87.0

### Startup
exec mako
exec swaymsg 'workspace 8; append_layout ~/.config/sway/workspace-8-layout.json'
exec flatpak run org.signal.Signal
exec google-chrome --app=https://app.fastmail.com --ozone-platform-hint=auto
exec google-chrome --app=https://bsky.app --ozone-platform-hint=auto
exec flatpak run com.slack.Slack
exec ghostty

include ~/.config/sway/config.d/*
