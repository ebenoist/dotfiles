// kanagawa-light -- Zellij chrome for Ghostty's "Kanagawa Lotus"
// Chrome colors from the Lotus palette (bg f2ecbc, fg 545464).
// Zellij 0.46 has no builtin kanagawa-light; this fills that gap.

themes {
  kanagawa-light {
    text_unselected {
      base 84 84 100            // lotus fg
      background 242 236 188    // terminal bg (matches Ghostty Kanagawa Lotus)
      emphasis_0 158 89 33      // autumnYellow
      emphasis_1 111 137 78     // autumnGreen
      emphasis_2 177 92 85      // waveRed
      emphasis_3 143 92 83      // oniViolet
    }
    text_selected {
      base 48 48 60             // sumiInk
      background 235 227 166    // widget surface (darker cream)
      emphasis_0 177 64 63      // samuraiRed
      emphasis_1 111 137 78     // autumnGreen
      emphasis_2 177 92 85      // waveRed
      emphasis_3 143 92 83      // oniViolet
    }
    ribbon_unselected {
      base 84 84 100
      background 231 222 164    // raised surface for pill separation
      emphasis_0 158 89 33
      emphasis_1 111 137 78
      emphasis_2 177 92 85
      emphasis_3 143 92 83
    }
    ribbon_selected {
      base 242 236 188          // bg
      background 177 64 63      // samuraiRed
      emphasis_0 242 236 188
      emphasis_1 204 145 55     // gold
      emphasis_2 158 60 40      // deep red
      emphasis_3 242 236 188
    }
    table_title {
      base 158 89 33
      background 0
      emphasis_0 177 64 63
      emphasis_1 177 92 85
      emphasis_2 111 137 78
      emphasis_3 143 92 83
    }
    table_cell_unselected {
      base 66 66 80
      background 0
      emphasis_0 158 89 33
      emphasis_1 177 92 85
      emphasis_2 111 137 78
      emphasis_3 143 92 83
    }
    table_cell_selected {
      base 66 66 80
      background 228 219 168    // line-highlight
      emphasis_0 158 89 33
      emphasis_1 177 92 85
      emphasis_2 111 137 78
      emphasis_3 143 92 83
    }
    list_unselected {
      base 66 66 80
      background 0
      emphasis_0 158 89 33
      emphasis_1 177 92 85
      emphasis_2 111 137 78
      emphasis_3 143 92 83
    }
    list_selected {
      base 66 66 80
      background 228 219 168
      emphasis_0 158 89 33
      emphasis_1 177 92 85
      emphasis_2 111 137 78
      emphasis_3 143 92 83
    }
    frame_unselected {
      base 196 186 140          // recessed stone
      background 0
      emphasis_0 84 84 100
      emphasis_1 111 137 78
      emphasis_2 177 92 85
      emphasis_3 143 92 83
    }
    frame_selected {
      base 177 64 63            // samuraiRed focus frame
      background 0
      emphasis_0 158 89 33
      emphasis_1 177 92 85
      emphasis_2 204 145 55
      emphasis_3 0
    }
    frame_highlight {
      base 158 89 33            // amber mode signal
      background 0
      emphasis_0 158 89 33
      emphasis_1 158 89 33
      emphasis_2 158 89 33
      emphasis_3 158 89 33
    }
    exit_code_success {
      base 111 137 78
      background 0
      emphasis_0 92 118 60
      emphasis_1 66 66 80
      emphasis_2 177 92 85
      emphasis_3 160 150 120
    }
    exit_code_error {
      base 177 64 63
      background 0
      emphasis_0 204 145 55
      emphasis_1 0
      emphasis_2 0
      emphasis_3 0
    }
    multiplayer_user_colors {
      player_1 177 64 63
      player_2 158 89 33
      player_3 111 137 78
      player_4 143 92 83
      player_5 92 118 60
      player_6 204 145 55
      player_7 120 32 32
      player_8 150 72 96
      player_9 140 110 40
      player_10 120 50 40
    }
  }
}
